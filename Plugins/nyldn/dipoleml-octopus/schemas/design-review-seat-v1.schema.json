{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design Review Seat v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approach",
    "dependencies",
    "risks",
    "testing",
    "integration"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "approach": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": ".*\\S.*"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": ".*\\S.*"
      },
      "maxItems": 20
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "risk",
          "mitigation"
        ],
        "properties": {
          "risk": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "mitigation": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          }
        }
      },
      "maxItems": 20
    },
    "testing": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": ".*\\S.*"
      },
      "maxItems": 20
    },
    "integration": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": ".*\\S.*"
      },
      "maxItems": 20
    }
  }
}

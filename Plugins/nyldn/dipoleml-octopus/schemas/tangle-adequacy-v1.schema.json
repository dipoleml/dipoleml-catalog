{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nyldn/claude-octopus/schemas/tangle-adequacy-v1.schema.json",
  "title": "Tangle Adequacy Review v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verdict",
    "reasons",
    "scope_review"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "verdict": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope_review": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "path",
          "reason"
        ],
        "properties": {
          "action": {
            "enum": [
              "move_to_reads",
              "remove_write",
              "add_write"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?:\\./)?(?!\\.{1,2}(?:/|$)|.*?/\\.{1,2}(?:/|$))[A-Za-z0-9_.@%+/-]+$",
            "allOf": [
              {
                "not": {
                  "pattern": "(^|/)[.]([Gg][Ii][Tt])($|/)"
                }
              }
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "pass"
          }
        }
      },
      "then": {
        "properties": {
          "scope_review": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}

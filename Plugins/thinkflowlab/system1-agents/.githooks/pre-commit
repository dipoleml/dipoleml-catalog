#!/usr/bin/env bash
# Enabled per clone by `git config core.hooksPath .githooks` (CONTRIBUTING.md): the staged Python files through ruff, the package through ty.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
files=()
while IFS= read -r f; do files+=("$f"); done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.py')
[ "${#files[@]}" -gt 0 ] || exit 0
uv run --no-sync ruff format --check "${files[@]}"
uv run --no-sync ruff check "${files[@]}"
uv run --no-sync ty check

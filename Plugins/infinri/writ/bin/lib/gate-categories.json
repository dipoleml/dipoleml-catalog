{
  "version": 2,
  "framework_detection": {
    "magento2": ["app/etc/env.php", "bin/magento"],
    "laravel": ["artisan", "bootstrap/app.php"],
    "django": ["manage.py"],
    "rails": ["config/routes.rb", "bin/rails"],
    "spring": ["pom.xml", "build.gradle"],
    "nestjs": ["nest-cli.json"],
    "express": ["node_modules/express"]
  },
  "exclusions": [
    "*__init__.py",
    "*__init__.pyi",
    "*conftest.py",
    "*/test/*",
    "*/tests/*",
    "*/Test/*",
    "*/_files/*",
    "*_test.*",
    "*.test.*",
    "*Test.php",
    "*Test.java",
    "*_spec.py",
    "*_spec.js",
    "*_spec.ts",
    "*.spec.js",
    "*.spec.ts",
    "*_spec.rb",
    "*/migrations/*",
    "*/alembic/*",
    "*/.claude/settings.json",
    "*/.claude/settings.local.json",
    "*/.claude/*.md"
  ]
}

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.kalshi-morning</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/ryanfrigo/dev/kalshi-ai-trading-bot/scripts/run_morning.sh</string>
  </array>

  <!-- Data + repricing only; never places orders. Runs 4:05am local (Pacific). -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>5</integer>
  </dict>

  <key>WorkingDirectory</key>
  <string>/Users/ryanfrigo/dev/kalshi-ai-trading-bot</string>
  <key>StandardOutPath</key>
  <string>/Users/ryanfrigo/dev/kalshi-ai-trading-bot/logs/daily_runs/morning_launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ryanfrigo/dev/kalshi-ai-trading-bot/logs/daily_runs/morning_launchd.err.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
